{
  "Serilog": {
    "Using": [ "Serilog.Enrichers.Environment" ],
    "Enrich": [ "WithEnvironmentUserName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs\\Sapphire_DiffTools_log.log",
          "shared": true,
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 5,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {EnvironmentUserName}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

<UserControl x:Class="sapphire_diffmaker.UserControls.XmlPreparator_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:sapphire_diffmaker.UserControls"
             xmlns:converters="clr-namespace:sapphire_diffmaker.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="600"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="12"
             FontFamily="{materialDesign:MaterialDesignFont}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- Заголовки секций -->
        <Style TargetType="TextBlock" x:Key="TextBlock1">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
        </Style>

        <Style TargetType="ListBoxItem" x:Key="CompactListBoxItem"
                BasedOn="{StaticResource MaterialDesignListBoxItem}">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        
        <!-- ListBox в стиле Material -->
        <Style TargetType="ListBox" x:Key="ListBox1"
               BasedOn="{StaticResource MaterialDesignListBox}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="10,0,10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CompactListBoxItem}"/>
        </Style>

        <!-- Основная (raised) кнопка -->
        <Style TargetType="Button" x:Key="Button1"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
        </Style>

        <!-- Плоская (текстовая) кнопка -->
        <Style TargetType="Button" x:Key="Button2"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
        </Style>

        <!-- Кнопка-удалить (круглая, красная) -->
        <Style TargetType="Button" x:Key="DeleteButton"
               BasedOn="{StaticResource MaterialDesignFlatDarkButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="#FFE57373"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE57373"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="11"/>
        </Style>

        <!-- Кнопка перемещения файла наверх -->
        <Style TargetType="Button" x:Key="MoveUpButton"
            BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="11"/>
        </Style>

        <Style TargetType="Button" x:Key="ButtonCancel"
            BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="13,5,13,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFE57373"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE57373"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
        </Style>

        <Style TargetType="CheckBox" x:Key="CheckBox1"
            BasedOn="{StaticResource MaterialDesignCheckBox}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="23"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                             Background="#FFE0E7ED" Margin="5,5,5,0"
                             UniformCornerRadius="6"
                             materialDesign:ElevationAssist.Elevation="Dp1"/>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Выбранные файлы:"
                   Style="{StaticResource TextBlock1}" FontSize="14"/>

        <ListBox Grid.Row="1" Grid.ColumnSpan="2"
                 ItemsSource="{Binding FilePaths}"
                 Style="{StaticResource ListBox1}"
                 x:Name="PathListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Width="1000">
                            <Button Style="{StaticResource DeleteButton}"
                                    Click="ButtonClick_RemovePath"
                                    Tag="{Binding}">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"/>
                            </Button>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="1" Grid.ColumnSpan="2" 
                Style="{StaticResource MoveUpButton}"
                Click="ButtonClick_MovelUp"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,10,0"
                Width="30" Height="30">
            <materialDesign:PackIcon Kind="ArrowUp" Width="20" Height="20"/>
        </Button>

        <!-- Кнопки -->
        <Button Grid.Row="2" Grid.Column="0"
                Click="ButtonClick_ChoosePaths"
                Style="{StaticResource Button2}"
                VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="FileMultiple" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Выбрать файлы для обработки" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Button Grid.Row="2" Grid.Column="1"
                Click="ButtonClick_ClearPaths"
                Style="{StaticResource Button2}"
                VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="DeleteSweep" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Очистить список выбранных файлов" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="5" BorderThickness="2" BorderBrush="#FFD2D2D2" CornerRadius="6">
            <ListBox
             ItemsSource="{Binding Steps}"
             Style="{StaticResource ListBox1}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected}" Style="{StaticResource CheckBox1}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Button Grid.Row="4" Grid.ColumnSpan="2"
            Click="ButtonClick_Execute"
            IsEnabled="{Binding IsEnabled}"
            Style="{StaticResource Button1}"
            VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="FileDocumentEdit" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Обработка XML" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        
        <!-- Готовность к запуску -->
        <!--<materialDesign:Card Grid.Row="5" Grid.ColumnSpan="2" Grid.RowSpan="2"
                             Margin="5" Background="Transparent"
                             UniformCornerRadius="6"
                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CheckCircle" Foreground="DarkGreen"
                                         Width="18" Height="18"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Приложение готово к запуску" Foreground="DarkGreen"
                           FontWeight="DemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>-->

        <!-- Прогрессбар -->
        <materialDesign:Card Grid.Row="5" Grid.RowSpan="2" Grid.ColumnSpan="2"
                     Background="#FFE0E7ED" Margin="5,0,5,0"
                     UniformCornerRadius="6"
                     materialDesign:ElevationAssist.Elevation="Dp1"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <ProgressBar Grid.Row="5" Grid.ColumnSpan="2"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Height="30"
                     Margin="12,5,12,5"/>
        <Border Grid.Row="5" Grid.ColumnSpan="2" Height="35" BorderBrush="#FFE0E7ED" BorderThickness="3" CornerRadius="6" Background="Transparent" Margin="10,5,10,5"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <TextBlock Grid.Row="5" Grid.ColumnSpan="2"
                   Text="{Binding Status}"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Button Grid.Row="6" Grid.ColumnSpan="2"
                Click="ButtonClick_Cancel"
                Style="{StaticResource ButtonCancel}"
                Background="#FFE57373"
                BorderBrush="#FFE57373"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Cancel" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Отмена операции" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Таймер -->
        <StackPanel Grid.Row="7" Grid.Column="0" Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="TimerOutline" VerticalAlignment="Center"
                                     Margin="5,0,5,0" Width="16" Height="16"/>
            <TextBlock Text="Время выполнения операции:"
                       FontSize="12" FontWeight="DemiBold" Margin="0,0,5,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ElapsedTime}" FontSize="12" Margin="0"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
<UserControl x:Class="sapphire_diffmaker.UserControls.AppInformation_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:sapphire_diffmaker.UserControls"
             xmlns:entities="clr-namespace:sapphire_diffmaker.Entities"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="12"
             FontFamily="{materialDesign:MaterialDesignFont}">

    <UserControl.Resources>
        <!-- Шаблон записи журнала изменений -->
        <DataTemplate DataType="{x:Type entities:ChangeLogEntry}">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Date}"
                           FontWeight="DemiBold"
                           Margin="0,0,0,2"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <TextBlock Text="{Binding Version}"
                           FontWeight="Bold"
                           Margin="0,0,0,5"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="{Binding Changes}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Версия приложения -->
        <TextBlock x:Name="appVersionLabel"
                   Grid.Row="0"
                   Text="Версия приложения: "
                   Margin="10,0,0,0"
                   FontSize="14"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>

        <!-- Описание приложения -->
        <TextBlock x:Name="description"
           Grid.Row="1"
           Text="Описание: "
           Margin="10,0,0,0"
           FontSize="12"
           VerticalAlignment="Top"
           TextWrapping="Wrap"
           FontWeight="Regular"/>
        
        <!-- Заголовок истории изменений -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    VerticalAlignment="Bottom" Margin="7,0,0,5">
            <materialDesign:PackIcon Kind="History"
                                     VerticalAlignment="Center"
                                     Width="18" Height="18"
                                     Margin="0,0,5,0"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="История изменений"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Карточка с журналом изменений -->
        <materialDesign:Card Grid.Row="3"
                             Background="#FFE0E7ED"
                             Margin="5,0,5,5"
                             UniformCornerRadius="6"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Margin="10"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChangeLogItemsControl"/>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</UserControl>
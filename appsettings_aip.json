{
  "Serilog": {
    "Using": [ "Serilog.Enrichers.Environment" ],
    "Enrich": [ "WithEnvironmentUserName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs\\Aip_DiffTools_log.log",
          "shared": true,
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 5,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {EnvironmentUserName}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AppSettings": {
    "AssemblyResolvePath": "C:\\Program Files\\Monitel\\CK-11\\Client",
    "ModelNavigatorPath": "C:\\Program Files\\Monitel\\CK-11\\Client",
    "ServerPath": "ia-im-aipcl.cdu.so@Mssql",
    "ProvidersDB": "ODB_EnergyMain",
    "Databases": [
      {
        "Name": "ODB_EnergyMain",
        "Description": "Главный источник данных"
      },
      {
        "Name": "ODB_EnergyWork_Act",
        "Description": "Рабочая модель для актуализации оборудования"
      },
      {
        "Name": "ODB_SCADA",
        "Description": "Модель SCADA"
      }
    ]
  }
}

